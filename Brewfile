# Brewfile — terminal setup dependencies.
# Reinstall everything with:  brew bundle --file=Brewfile

# Prompt (shell-agnostic, fast).
brew "starship"

# zsh quality-of-life plugins.
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Modern `cat` with syntax highlighting (aliased to `cat` in .zshrc).
brew "bat"

# Nerd Font used by both Terminal profiles (provides prompt glyphs/icons).
cask "font-meslo-lg-nerd-font"
